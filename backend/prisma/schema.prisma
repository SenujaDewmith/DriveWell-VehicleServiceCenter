generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)
  users     User[]

  @@map("roles")
}

model User {
  user_id        Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(150)
  password_hash  String   @db.VarChar(255)
  role_id        Int
  account_status String   @default("active") @db.VarChar(30)
  created_at     DateTime @default(now())

  // Set on "forgot password" request, cleared once used or expired. We store a
  // sha256 hash (not the raw token that goes out in the email) so a DB leak
  // alone can't be replayed into a valid reset link.
  reset_token_hash       String?   @db.VarChar(64)
  reset_token_expires_at DateTime?

  role     Role      @relation(fields: [role_id], references: [role_id])
  customer Customer?
  staff    Staff?

  vehicles                   Vehicle[]                @relation("CustomerVehicles")
  previously_owned_vehicles  Vehicle[]                @relation("PreviousVehicleOwner")
  reservations               Reservation[]            @relation("CustomerReservations")
  supervised_records         ServiceRecord[]          @relation("SupervisorRecords")
  staff_assignments          ServiceStaffAssignment[]
  invoices_issued            Invoice[]                @relation("CashierInvoices")
  feedback_submitted         Feedback[]               @relation("CustomerFeedback")
  activity_logs              ActivityLog[]
  transfer_requests_made     VehicleTransferRequest[] @relation("TransferRequestsMade")
  transfer_requests_reviewed VehicleTransferRequest[] @relation("TransferRequestsReviewed")

  @@index([reset_token_hash])
  @@map("users")
}

model Customer {
  user_id         Int     @id
  full_name       String  @db.VarChar(150)
  phone           String? @db.VarChar(20)
  secondary_phone String? @db.VarChar(20)
  address         String?
  avatar_url      String? @db.VarChar(500)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("customers")
}

model Staff {
  user_id    Int     @id
  full_name  String  @db.VarChar(150)
  phone_no   String? @db.VarChar(20)
  avatar_url String? @db.VarChar(500)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("staff")
}

model VehicleMake {
  make_id Int    @id @default(autoincrement())
  // Case-insensitive duplicate checking happens in the controller (Postgres
  // ILIKE via Prisma's `mode: "insensitive"`) — this exact-case constraint is
  // just the DB-level backstop against races or writes that skip that check.
  name    String @unique @db.VarChar(100)

  models   VehicleModel[]
  vehicles Vehicle[]

  @@map("vehicle_makes")
}

model VehicleModel {
  model_id        Int    @id @default(autoincrement())
  name            String @db.VarChar(150)
  make_id         Int
  start_year      Int?
  end_year        Int?
  vehicle_type_id Int?

  make         VehicleMake  @relation(fields: [make_id], references: [make_id])
  vehicle_type VehicleType? @relation(fields: [vehicle_type_id], references: [type_id])
  vehicles     Vehicle[]

  // Same model name can exist under different makes (e.g. two different
  // makes both selling a "GT"), so uniqueness is scoped to (name, make_id).
  @@unique([name, make_id])
  @@map("vehicle_models")
}

model VehicleType {
  type_id Int    @id @default(autoincrement())
  name    String @unique @db.VarChar(50)

  models   VehicleModel[]
  vehicles Vehicle[]

  @@map("vehicle_types")
}

model Vehicle {
  vehicle_id           Int       @id @default(autoincrement())
  customer_id          Int?
  previous_customer_id Int?
  make_id              Int?
  model_id             Int?
  // Set when the customer's make/model wasn't in the catalog — kept as a
  // permanent audit trail of what they typed, even after a manager resolves
  // it by linking make_id/model_id to a real (possibly newly-created) entry.
  // model_id IS NULL is the "pending catalog review" signal.
  custom_make          String?   @db.VarChar(100)
  custom_model         String?   @db.VarChar(150)
  vehicle_type_id      Int
  year                 Int?
  plate_no             String    @unique @db.VarChar(30)
  created_at           DateTime  @default(now())
  detached_at          DateTime?

  customer          User?                    @relation("CustomerVehicles", fields: [customer_id], references: [user_id], onDelete: SetNull)
  previous_customer User?                    @relation("PreviousVehicleOwner", fields: [previous_customer_id], references: [user_id], onDelete: SetNull)
  make              VehicleMake?             @relation(fields: [make_id], references: [make_id])
  model             VehicleModel?            @relation(fields: [model_id], references: [model_id])
  vehicle_type      VehicleType              @relation(fields: [vehicle_type_id], references: [type_id])
  reservations      Reservation[]
  transfer_requests VehicleTransferRequest[]

  @@map("vehicles")
}

model VehicleTransferRequest {
  request_id                   Int       @id @default(autoincrement())
  vehicle_id                   Int
  requester_id                 Int
  // Snapshot of who owned the vehicle when the request was filed — plain int,
  // no relation, since it's only ever used for display/audit, not queried by join.
  current_owner_id             Int?
  // Snapshot of the phone number given at submission time — so staff can call
  // whoever filed the request, even if their profile phone changes later.
  // Null for staff-initiated rows (source = "Staff"), which skip the customer
  // submission flow entirely.
  contact_phone                String?   @db.VarChar(20)
  status                       String    @default("Pending") @db.VarChar(20)
  // "Customer" = filed by a customer through the transfer-request flow (the
  // default). "Staff" = created directly by a manager's force-transfer, purely
  // as a history record — always inserted already Approved, never Pending.
  source                       String    @default("Customer") @db.VarChar(20)
  // Nulled out once resolved (Approved/Rejected) — the actual files are deleted
  // from disk at that point too. Documents shouldn't outlive their one-time purpose.
  registration_book_photo_path String?   @db.VarChar(500)
  nic_photo_path               String?   @db.VarChar(500)
  reviewer_id                  Int?
  reviewed_at                  DateTime?
  rejection_reason             String?   @db.VarChar(500)
  created_at                   DateTime  @default(now())

  vehicle   Vehicle @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  requester User    @relation("TransferRequestsMade", fields: [requester_id], references: [user_id], onDelete: Cascade)
  reviewer  User?   @relation("TransferRequestsReviewed", fields: [reviewer_id], references: [user_id], onDelete: SetNull)

  @@map("vehicle_transfer_requests")
}

model ServicePackage {
  package_id         Int      @id @default(autoincrement())
  name               String   @db.VarChar(150)
  package_code       String?  @unique @db.VarChar(20)
  description        String?
  estimated_duration Int      @default(60)
  price              Decimal  @db.Decimal(10, 2)
  image_url          String?  @db.VarChar(500)
  max_capacity       Int      @default(3)
  is_active          Boolean  @default(true)
  // Manager-curated pick for the "Popular Service Packages" section on the public landing
  // page — deliberately not derived from booking counts (see project notes: a manually
  // curated highlight avoids just crowning whichever package is cheapest/highest-volume).
  is_featured        Boolean  @default(false)
  created_at         DateTime @default(now())

  reservations Reservation[]

  @@map("service_packages")
}

model WorkingConfig {
  config_id               Int      @id @default(autoincrement())
  working_days            String   @default("1,2,3,4,5")
  day_start_time          DateTime @db.Time
  day_end_time            DateTime @db.Time
  // Same-day bookings stop being accepted this many minutes before closing —
  // e.g. 240 (4h) with an 18:00 close means no new same-day bookings after 14:00.
  same_day_cutoff_minutes Int      @default(240)
  // How far into the future a customer may book — e.g. 60 means today plus up to 60 days.
  max_advance_days        Int      @default(60)
  // Manager-editable support number shown to anonymous visitors and customers
  // hitting a self-service dead end (blocked cancellation, failed transfer request).
  contact_phone           String?  @db.VarChar(20)

  @@map("working_config")
}

enum PaymentStatus {
  Unpaid
  Paid
}

model BlockedTime {
  block_id   Int       @id @default(autoincrement())
  date       DateTime? @db.Date
  start_time DateTime  @db.Time
  end_time   DateTime  @db.Time
  reason     String?   @db.VarChar(255)
  created_at DateTime  @default(now())

  @@map("blocked_times")
}

model Reservation {
  reservation_id    Int       @id @default(autoincrement())
  booking_ref       String?   @unique @db.VarChar(20)
  customer_id       Int
  vehicle_id        Int
  package_id        Int
  start_time        DateTime  @db.Time
  end_time          DateTime  @db.Time
  service_date      DateTime  @db.Date
  // Enforced beyond app-level validation by a DB CHECK constraint (see
  // scripts/add-status-constraint.js) restricting this to the 6 lifecycle values —
  // kept as a plain String (not a Prisma enum) so the JS-facing value for every status,
  // including "No-show", matches exactly what the rest of the app already reads/writes.
  status            String    @default("Booked") @db.VarChar(30)
  created_at        DateTime  @default(now())
  // Clickwrap consent record — which T&C version the customer accepted and when.
  // Nullable because reservations created before this feature carry no acceptance.
  terms_version     String?   @db.VarChar(10)
  terms_accepted_at DateTime?
  // Snapshot of the contact number the customer gave when booking/rescheduling — so
  // staff can always reach whoever made this specific booking, even if their profile
  // phone changes later. Null for reservations created before this field existed, and
  // untouched by a manager-initiated reschedule (admin_fd's RescheduleBookingModal
  // doesn't collect a phone number, only date/time).
  contact_phone     String?   @db.VarChar(20)

  customer_user  User           @relation("CustomerReservations", fields: [customer_id], references: [user_id])
  vehicle        Vehicle        @relation(fields: [vehicle_id], references: [vehicle_id])
  package        ServicePackage @relation(fields: [package_id], references: [package_id])
  service_record ServiceRecord?
  invoice        Invoice?
  feedback       Feedback?

  @@map("reservations")
}

model ServiceRecord {
  record_id             Int       @id @default(autoincrement())
  reservation_id        Int       @unique
  supervisor_id         Int?
  // Snapshot of the supervisor's name at the time this record was started — so
  // it keeps reading correctly even if that staff account is later deleted
  // (supervisor_id goes null on delete, but the historical record shouldn't).
  supervisor_name       String?   @db.VarChar(150)
  remarks               String?
  quality_checked       Boolean   @default(false)
  // Odometer reading is only collected when this service involved an oil
  // change (engine or gear oil) — supervisor self-declares via has_oil_change
  // rather than it being inferred from the package/catalog.
  has_oil_change        Boolean   @default(false)
  current_odometer      Int?
  next_service_odometer Int?
  started_at            DateTime?
  completed_at          DateTime?

  reservation Reservation              @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade)
  supervisor  User?                    @relation("SupervisorRecords", fields: [supervisor_id], references: [user_id])
  assignments ServiceStaffAssignment[]
  items       ServiceRecordItem[]

  @@map("service_records")
}

model ServiceStaffAssignment {
  assignment_id Int     @id @default(autoincrement())
  record_id     Int
  staff_id      Int?
  // Snapshot of the assigned staff member's name at assignment time — same
  // reasoning as ServiceRecord.supervisor_name above.
  staff_name    String? @db.VarChar(150)
  work_note     String? @db.VarChar(255)

  record ServiceRecord @relation(fields: [record_id], references: [record_id], onDelete: Cascade)
  staff  User?         @relation(fields: [staff_id], references: [user_id], onDelete: SetNull)

  @@unique([record_id, staff_id])
  @@map("service_staff_assignments")
}

// Manager-curated catalog of common additional repair/part charges — the
// reference price list the cashier draws from when itemizing an invoice.
model ChargeCatalogItem {
  catalog_item_id Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  description     String?
  default_price   Decimal  @db.Decimal(10, 2)
  category        String?  @db.VarChar(50)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  service_record_items ServiceRecordItem[]
  invoice_items        InvoiceItem[]

  @@map("charge_catalog_items")
}

// Structured note of additional work/parts a supervisor found necessary during
// a service — documentation only, no price. The cashier prices these at invoice time.
model ServiceRecordItem {
  item_id         Int      @id @default(autoincrement())
  record_id       Int
  catalog_item_id Int?
  description     String   @db.VarChar(255)
  quantity        Int      @default(1)
  created_at      DateTime @default(now())

  record       ServiceRecord      @relation(fields: [record_id], references: [record_id], onDelete: Cascade)
  catalog_item ChargeCatalogItem? @relation(fields: [catalog_item_id], references: [catalog_item_id])

  @@map("service_record_items")
}

model Invoice {
  invoice_id         Int           @id @default(autoincrement())
  reservation_id     Int           @unique
  cashier_id         Int?
  // Snapshot of the cashier's name at the time this invoice was generated —
  // same reasoning as ServiceRecord.supervisor_name above.
  cashier_name       String?       @db.VarChar(150)
  base_amount        Decimal       @db.Decimal(10, 2)
  additional_charges Decimal       @default(0) @db.Decimal(10, 2)
  discount           Decimal       @default(0) @db.Decimal(10, 2)
  total_amount       Decimal       @db.Decimal(10, 2)
  payment_status     PaymentStatus @default(Unpaid)
  payment_method     String?       @db.VarChar(30)
  notes              String?
  generated_at       DateTime      @default(now())

  reservation Reservation   @relation(fields: [reservation_id], references: [reservation_id])
  cashier     User?         @relation("CashierInvoices", fields: [cashier_id], references: [user_id])
  items       InvoiceItem[]

  @@map("invoices")
}

// Itemized invoice line — one per additional repair/part charge the cashier applies,
// priced with the manager's charge catalog as reference (editable per case).
model InvoiceItem {
  invoice_item_id Int     @id @default(autoincrement())
  invoice_id      Int
  catalog_item_id Int?
  description     String  @db.VarChar(255)
  unit_price      Decimal @db.Decimal(10, 2)
  quantity        Int     @default(1)
  line_total      Decimal @db.Decimal(10, 2)

  invoice      Invoice            @relation(fields: [invoice_id], references: [invoice_id], onDelete: Cascade)
  catalog_item ChargeCatalogItem? @relation(fields: [catalog_item_id], references: [catalog_item_id])

  @@map("invoice_items")
}

model Feedback {
  feedback_id    Int      @id @default(autoincrement())
  reservation_id Int      @unique
  customer_id    Int
  rating         Int
  comment        String?
  submitted_at   DateTime @default(now())
  is_featured    Boolean  @default(false)

  reservation Reservation @relation(fields: [reservation_id], references: [reservation_id])
  customer    User        @relation("CustomerFeedback", fields: [customer_id], references: [user_id])

  @@map("feedback")
}

model ActivityLog {
  log_id      Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(255)
  entity_type String?  @db.VarChar(50)
  entity_id   Int?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id])

  @@map("activity_log")
}
